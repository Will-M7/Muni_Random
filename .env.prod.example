# Copie este archivo fuera del repositorio como .env.prod y protejalo con chmod 600.
# Complete cada valor en el servidor. No use las credenciales de desarrollo.
COMPOSE_PROJECT_NAME=sm-prod-municipalidad
# IP privada concreta del servidor y puertos 80/443 una vez confirmados por el ingeniero.
APP_BIND_IP=127.0.0.1
HTTPS_PORT=8443
HTTP_PORT=8088
SERVER_NAME=
DB_NAME=san_miguel_prod
DB_USER=
DB_PASSWORD_FILE=
MYSQL_ROOT_PASSWORD_FILE=
JWT_SECRET_FILE=
IDENTITY_MASTER_KEY_FILE=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_FILE=
CORS_ORIGINS=
TLS_CERT_PATH=
TLS_KEY_PATH=
# CA corporativa confiable, si no se utiliza la confianza del sistema operativo.
TLS_CA_PATH=
